PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/kuentra
CORS_ORIGIN=http://localhost:3000
# La misma clave secreta se configura también en el frontend.
ADMIN_API_KEY=reemplazar-por-una-clave-aleatoria-larga
IP_HASH_SALT=reemplazar-por-un-secreto-aleatorio-largo
# En Railway, montar un volumen en /app/data y usar esta ruta.
REVIEW_UPLOAD_DIR=/app/data/reviews
