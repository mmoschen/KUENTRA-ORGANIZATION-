KUENTRA_API_URL=http://localhost:4000
# URL expuesta de la API: esta se usa desde el navegador para enviar opiniones.
NEXT_PUBLIC_KUENTRA_API_URL=http://localhost:4000
# Debe coincidir con ADMIN_API_KEY configurada en la API. Nunca usar NEXT_PUBLIC_ para esta variable.
ADMIN_API_KEY=reemplazar-por-la-misma-clave-secreta-de-la-api
ADMIN_SESSION_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Generar con: npm run admin:hash --workspace=@kuentra/api
ADMIN_PASSWORD_HASH=scrypt\$sal\$hash
